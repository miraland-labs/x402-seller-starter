# Public URL of this seller API (no trailing slash) — used in x402 Payment Required `resource.url`.
# Examples: http://127.0.0.1:3000 (local), https://api.example.com (production / behind a tunnel).
SELLER_PUBLIC_BASE_URL=http://127.0.0.1:3000

# pr402 base URL (no trailing slash).
# --- Production (Solana mainnet) — recommended for real traffic ---
FACILITATOR_BASE_URL=https://ipay.sh
# --- Devnet / preview (for integration testing) ---
# FACILITATOR_BASE_URL=https://preview.ipay.sh

# Merchant Solana pubkey (base58).
MERCHANT_WALLET=<your_base58_merchant_pubkey>

# Bind address for the local Express server.
BIND_ADDR=127.0.0.1:3000

# Route paths.
SELLER_FREE_PATH=/api/free
SELLER_PAID_PATH=/api/premium

# Resource metadata embedded in the 402 body.
SELLER_RESOURCE_DESCRIPTION=Example premium API (x402 seller starter · TypeScript)
SELLER_RESOURCE_MIME=application/json

# --- accepts[] — discrete vars; pr402 verify needs all of these + `extra` ---
X402_SCHEME=v2:solana:exact
# --- Production (Solana mainnet) ---
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_ASSET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# --- Devnet (for integration testing) ---
# X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# $0.01 USDC (6 decimals).
X402_AMOUNT=10000
# Vault PDA: run `npm run find-payto` to compute this.
X402_PAY_TO=<RUN_FIND_PAYTO_OR_PASTE_VAULT_PDA_HERE>
# 120 s is comfortable for `exact`. Raise to 3600 for `sla-escrow`.
X402_MAX_TIMEOUT_SECONDS=120

# REQUIRED for pr402 exact verify. Refresh from `/supported` or `find-payto` on every facilitator
# redeploy — programId / configAddress / feePayer change across devnet, preview, mainnet.
# `npm run find-payto` prints a ready-to-paste X402_ACCEPTS_EXTRA_JSON=... line.
X402_ACCEPTS_EXTRA_JSON=<RUN_FIND_PAYTO_OR_PASTE_EXTRA_JSON_HERE>

# Public URL of this seller API (no trailing slash) — used in x402 Payment Required `resource.url`.
# Examples: http://127.0.0.1:3000 (local; match BIND_ADDR / how you curl)
#           https://api.example.com (production; URL clients use, often behind a reverse proxy
#                                    or tunnel like ngrok / cloudflared for dev — expose the same
#                                    origin the buyer will fetch from).
SELLER_PUBLIC_BASE_URL=http://127.0.0.1:3000

# pr402 base URL (no trailing slash).
# --- Production (Solana mainnet) — recommended for real traffic ---
FACILITATOR_BASE_URL=https://ipay.sh
# --- Devnet / preview (for integration testing) ---
# FACILITATOR_BASE_URL=https://preview.ipay.sh
#
# Find X402_PAY_TO: `cargo run --example find_payto` (uses MERCHANT_WALLET + GET /supported).
# Optional: SELLER_FETCH_ONBOARD_TX=1 → POST .../sellers/provision-tx (not needed for payTo).
# Optional: SELLER_PROVISION_ASSET=USDC (default; or SOL, USDT, or a base58 mint) when fetching provision JSON.
# Note: the pr402 facilitator retired WSOL as a friendly seller rail (6-decimal SPL fee floor
# vs. 9-decimal WSOL would silently undercharge at the floor boundary). Use SOL for SOL-denominated
# payments and USDC for stable-unit payments.
#
# Merchant Solana pubkey (base58). Alias: SELLER_WALLET.
MERCHANT_WALLET=<your_base58_merchant_pubkey>

# Optional copy (values with spaces must be double-quoted — dotenvy parses like sh)
SELLER_RESOURCE_DESCRIPTION="Example premium API (x402 seller starter)"
SELLER_RESOURCE_MIME=application/json
SELLER_FREE_PATH=/api/free
SELLER_PAID_PATH=/api/premium
BIND_ADDR=127.0.0.1:3000

# --- accepts[]: choose ONE style ---

# (A) Full accepts JSON (for exact rail, payTo = vault PDA — same value `find_payto` prints):
# X402_ACCEPTS_JSON='[{"scheme":"v2:solana:exact","network":"solana:...","asset":"...","amount":"10000","payTo":"<VAULT_FROM_FIND_PAYTO>","maxTimeoutSeconds":600,"extra":{...}}]'

# (B) Or discrete vars below + REQUIRED `extra` for pr402 exact verify (copy from `find_payto` output):
X402_SCHEME=v2:solana:exact
# --- Production (Solana mainnet) ---
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_ASSET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# --- Devnet (for integration testing) ---
# X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# $0.01 USDC floor (1 cent) — pr402's published min_fee_amount on mainnet.
X402_AMOUNT=10000
# Exact rail: vault PDA = output of `cargo run --example find_payto` (GET /supported + MERCHANT_WALLET).
X402_PAY_TO=<RUN_FIND_PAYTO_OR_PASTE_VAULT_PDA_HERE>
# 120 s is a comfortable ceiling for `exact` settle. Raise to 3600 for `sla-escrow`, which is
# time-bound on the escrow side — this value still represents the buyer-tolerance horizon.
X402_MAX_TIMEOUT_SECONDS=120

# REQUIRED for pr402 exact verify. Refresh from `/supported` or `find_payto` on every facilitator
# redeploy — the programId / configAddress / feePayer change across devnet, preview, and mainnet,
# and a stale value here silently breaks verify on-chain.
#
# IMPORTANT: `find_payto` now injects `merchantWallet` into this JSON automatically.
# If you build the extra JSON manually, ALWAYS include:
#   "merchantWallet": "<your MERCHANT_WALLET base58>"
# Without it, the facilitator cannot resolve your identity when the vault doesn't exist yet
# (first payment / JIT provision), and payments may settle to a wrong address.
#
#   cargo run --example find_payto    # prints an X402_ACCEPTS_EXTRA_JSON=... line to paste here
#
X402_ACCEPTS_EXTRA_JSON=<RUN_FIND_PAYTO_OR_PASTE_EXTRA_JSON_HERE>

RUST_LOG=info
